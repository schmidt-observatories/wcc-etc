{
    "instrument": {
        "name": "Lazuli WCC r 20250925 EOL RTX 10perc",
        "description": "End-to-End Throughput of the Lazuli telescope with the WCC instrument and SLOAN r' filter, EOL, RTX Requirement, 10% lower",
        "outputfolder": "output/wcc/"
    },
    "wavelength_range": {
        "start_nm": 350.0,
        "end_nm": 1800.0,
        "step_nm": 5.0
    },
    "settings": {
        "interpolation_method": "linear",
        "plot_results": true,
        "debug_output": true,
        "save_plots_pdf": true,
        "save_instrument_data": true
    },
    "surfaces": {
        "EOL_req": {
            "file": "requirements/rtx_telescope_eol_req_10perc.csv",
            "description": "RTX EOL Requirement",
            "wavelength_unit": "nm",
            "throughput_scale": "fraction"
        },
        "filter_sloan_r": {
            "file": "filter/SLOAN_SDSS.rprime_filter.dat",
            "description": "Sloan r-band filter",
            "wavelength_unit": "angstrom",
            "throughput_scale": "fraction"
        },
        "detector": {
            "file": "detector/IMX455_QE_digitized_corrected.csv",
            "description": "Sony IMX 455 sCMOS detector quantum efficiency",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        }
    },
    "subsystems": {
        "telescope": {
            "surfaces": [
                "EOL_req"
            ],
            "description": "Telescope optics, RTX EOL Req"
        },
        "photometric_instrument": {
            "surfaces": [
                "filter_sloan_r",
                "detector"
            ],
            "description": "Photometric system"
        }
    },
    "instruments": {
        "photometer": {
            "subsystems": [
                "telescope",
                "photometric_instrument"
            ],
            "description": "Lazuli Photometric System: Telescope + WCC, EOL"
        }
    }
}