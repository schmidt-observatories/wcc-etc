{
    "instrument": {
        "name": "Lazuli WCC u 20250912",
        "description": "End-to-End Throughput of the Lazuli telescope with the WCC instrument and SLOAN u' filter",
        "outputfolder": "output/wcc/"
    },
    "wavelength_range": {
        "start_nm": 300.0,
        "end_nm": 1800.0,
        "step_nm": 5.0
    },
    "settings": {
        "interpolation_method": "linear",
        "plot_results": true,
        "debug_output": true,
        "save_plots_pdf": true,
        "save_instrument_data": true
    },
    "surfaces": {
        "mirror_PM": {
            "file": "coating/RTX_20250819_bare_aluminum_reflectance_extracted.csv",
            "description": "Primary mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "mirror_SM": {
            "file": "coating/FSS99_Silver_Mirror.csv",
            "description": "Secondary mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "mirror_TM": {
            "file": "coating/FSS99_Silver_Mirror.csv",
            "description": "Tertiary mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "mirror_FSM": {
            "file": "coating/FSS99_Silver_Mirror.csv",
            "description": "M4 - fast steering mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "filter_sloan_u": {
            "file": "filter/SLOAN_SDSS.uprime_filter.dat",
            "description": "Sloan u-band filter",
            "wavelength_unit": "angstrom",
            "throughput_scale": "fraction"
        },
        "detector": {
            "file": "detector/IMX455_QE_digitized_corrected.csv",
            "description": "Sony IMX 455 sCMOS detector quantum efficiency",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        }
    },
    "subsystems": {
        "telescope": {
            "surfaces": [
                "mirror_PM",
                "mirror_SM",
                "mirror_TM",
                "mirror_FSM"
            ],
            "description": "Telescope optics"
        },
        "photometric_instrument": {
            "surfaces": [
                "filter_sloan_u",
                "detector"
            ],
            "description": "Photometric system"
        }
    },
    "instruments": {
        "photometer": {
            "subsystems": [
                "telescope",
                "photometric_instrument"
            ],
            "description": "Lazuli Photometric System: Telescope + WCC"
        }
    }
}