{
    "instrument": {
        "name": "Lazuli WCC H-alpha 20251010 EOL_qCMOS",
        "description": "End-to-End Throughput of the Lazuli telescope with the WCC instrument and H-alpha filter, EOL, qCMOS detector",
        "outputfolder": "output/wcc/"
    },
    "wavelength_range": {
        "start_nm": 250.0,
        "end_nm": 1800.0,
        "step_nm": 0.5
    },
    "settings": {
        "interpolation_method": "linear",
        "plot_results": true,
        "debug_output": true,
        "save_plots_pdf": true,
        "save_instrument_data": true
    },
    "surfaces": {
        "mirror_PM": {
            "file": "coating/RTX_20250819_bare_aluminum_reflectance_extracted.csv",
            "description": "Primary mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "mirror_SM": {
            "file": "coating/RTX_20250820_M2_3_4_Coating.csv",
            "description": "Secondary mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "mirror_TM": {
            "file": "coating/RTX_20250820_M2_3_4_Coating.csv",
            "description": "Tertiary mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "mirror_FSM": {
            "file": "coating/RTX_20250820_M2_3_4_Coating.csv",
            "description": "M4 - fast steering mirror coating",
            "wavelength_unit": "nm",
            "throughput_scale": "percent"
        },
        "EOL": {
            "file": "coating/rtx_bol_eol_ratio_smoothed_gaussian_45px_20250907.csv",
            "description": "EOL / BOL reflectance ratio, Gaussian smoothed 45px",
            "wavelength_unit": "nm",
            "throughput_scale": "fraction"
        },
        "filter_H_alpha": {
            "file": "filter/LasCumbres_LasCumbres.Halpha.txt",
            "description": "H-alpha filter",
            "wavelength_unit": "angstrom",
            "throughput_scale": "fraction"
        },
        "detector": {
            "file": "detector/qCMOS/qCMOS_QE.csv",
            "description": "HWK4123 qCMOS detector quantum efficiency",
            "wavelength_unit": "nm",
            "throughput_scale": "fraction"
        }
    },
    "subsystems": {
        "telescope": {
            "surfaces": [
                "mirror_PM",
                "mirror_SM",
                "mirror_TM",
                "mirror_FSM",
                "EOL"
            ],
            "description": "Telescope optics"
        },
        "photometric_instrument": {
            "surfaces": [
                "filter_H_alpha",
                "detector"
            ],
            "description": "Photometric system"
        }
    },
    "instruments": {
        "photometer": {
            "subsystems": [
                "telescope",
                "photometric_instrument"
            ],
            "description": "Lazuli Photometric System: Telescope + WCC, EOL"
        }
    }
}