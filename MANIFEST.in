# Explicit allowlist: the sdist/wheel contents must not depend on what happens
# to be in a developer's working tree (#62). Mirrors [tool.setuptools.package-data].
include README.md LICENSE pyproject.toml
recursive-include src/wcc_etc/data/config *.toml
recursive-include src/wcc_etc/data/throughput *.csv *.dat
recursive-include src/wcc_etc/data/sensors *.csv *.fits *.txt *.md
recursive-include src/wcc_etc/data/astrophysics *.dat *.fits *.md
recursive-include src/wcc_etc/data/astr_obj_models/stars/pickles_models *.csv *.md
recursive-include src/wcc_etc/data/astr_obj_models/stars/pickles_models/dat_uvk *.fits
recursive-include src/wcc_etc/data/astr_obj_models/galaxies/brown *
include src/wcc_etc/data/psfs/CAD_*_Huygens-PSF-Data_Linear.fits
global-exclude .DS_Store *.swp *.swo *~ *.pyc __pycache__ *_report.pdf *.fgd
